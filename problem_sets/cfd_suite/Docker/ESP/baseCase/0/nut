FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "1";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    wall
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    symPlane
    {
        type            symmetry;
    }
    a1
    {
        type            calculated;
        value           uniform 0;
    }
    a0
    {
        type            calculated;
        value           uniform 0;
    }
}


