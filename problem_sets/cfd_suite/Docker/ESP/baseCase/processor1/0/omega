FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 14.855;

boundaryField
{
    wall
    {
        type            epsilonWallFunction;
        value           uniform 14.855;
    }
    symPlane
    {
        type            symmetry;
    }
    a0
    {
        type            fixedValue;
        value           nonuniform 0();
    }
    a1
    {
        type            zeroGradient;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 14.855;
    }
    procBoundary1to3
    {
        type            processor;
        value           uniform 14.855;
    }
}


